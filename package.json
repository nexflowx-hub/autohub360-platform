{
  "name": "autohub360-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:tech": "turbo dev --filter=@autohub360/tech",
    "dev:store": "turbo dev --filter=@autohub360/store",
    "build": "turbo build",
    "build:tech": "turbo build --filter=@autohub360/tech",
    "build:store": "turbo build --filter=@autohub360/store",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "deps:check": "node scripts/check-workspace-deps.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "seed:sql": "node scripts/generate-seed-sql.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
